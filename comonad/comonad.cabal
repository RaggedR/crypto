cabal-version:      2.4
name:               comonad
version:            0.1.0.0
synopsis:           Finance as a tape comonad: strategies as co-Kleisli arrows.
author:             Robin Langer
build-type:         Simple

common warnings
    ghc-options: -Wall -Wno-name-shadowing

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  Tape
                      Finance
                      Forward
                      Boundary
                      Stencil
    build-depends:    base >=4 && <5, array, directory
    default-language: Haskell2010

executable comonad
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base, comonad
    default-language: Haskell2010

executable fit
    import:           warnings
    hs-source-dirs:   app
    main-is:          Fit.hs
    build-depends:    base, comonad, directory
    default-language: Haskell2010

executable edge
    import:           warnings
    hs-source-dirs:   app
    main-is:          Edge.hs
    build-depends:    base, comonad, directory
    default-language: Haskell2010

executable pc1
    import:           warnings
    hs-source-dirs:   app
    main-is:          PC1.hs
    build-depends:    base, comonad
    default-language: Haskell2010

executable walkforward
    import:           warnings
    hs-source-dirs:   app
    main-is:          WalkForward.hs
    build-depends:    base, comonad
    default-language: Haskell2010

test-suite ols
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          OLS.hs
    build-depends:    base, comonad
    default-language: Haskell2010

test-suite golden
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Golden.hs
    build-depends:    base, comonad
    default-language: Haskell2010
